{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^unity-deps\\.txt$/"],
      "matchStrings": [
        "(?<depName>com\\.unity\\.[a-z]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "unity3d-packages",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^key-collision-deps\\.txt$/"],
      "matchStrings": [
        "(?<depName>com\\.unity\\.[a-z0-9.-]+)=(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "unity3d-packages",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["unity3d-packages"],
      "groupName": "Unity embedded notes",
      "groupSlug": "unity-embedded-notes"
    },
    {
      "matchFileNames": ["key-collision-deps.txt"],
      "matchDatasources": ["unity3d-packages"],
      "registryUrls": [
        "https://raw.githubusercontent.com/MindTooth/renovate-test-46986/master/registry"
      ],
      "groupName": "Embedded notes key collision",
      "groupSlug": "embedded-notes-key-collision",
      "ignoreUnstable": false
    },
    {
      "matchPackageNames": ["com.unity.inputsystem"],
      "allowedVersions": "<=1.15.0"
    },
    {
      "matchPackageNames": ["com.unity.cinemachine"],
      "allowedVersions": "<=3.1.2"
    }
  ],
  "dependencyDashboard": false,
  "automerge": false
}
